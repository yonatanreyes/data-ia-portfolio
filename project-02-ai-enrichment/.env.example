# One of: openai, zai, mistral, deepseek, groq, gemini, anthropic.
# Any other value requires AI_BASE_URL below.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=your_openai_api_key_here

# Only needed to override the default endpoint of a known provider,
# or to use a new OpenAI-compatible provider not in the registry.
AI_BASE_URL=

AI_MAX_RETRIES=3

# --- Input/output files ---
INPUT_FILE=data/input_data.csv
OUTPUT_FILE=output/output_data.csv